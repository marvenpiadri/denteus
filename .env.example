# PostgreSQL connection string. Used by the standalone Fastify backend.
# Use a local database for development and a managed PostgreSQL instance in production.
# Never commit real credentials.
DATABASE_URL="postgresql://dentaleus:change-me@localhost:5432/dentaleus"

# Standalone Fastify API
API_HOST="0.0.0.0"
API_PORT="4100"
DATABASE_POOL_MAX="10"
LOG_LEVEL="info"
TRUST_PROXY="false"

# Public origin for absolute links and auth callbacks.
APP_URL="https://dentaleus.com"

# GEMINI_API_KEY: Required only for Gemini AI API calls.
# Configure through your deployment environment/secrets manager.
GEMINI_API_KEY="replace-with-your-key"
