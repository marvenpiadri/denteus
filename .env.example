# PostgreSQL connection string used by Prisma.
# Use a local database for development and a managed PostgreSQL instance in production.
# Never commit real credentials.
DATABASE_URL="postgresql://dentaleus:change-me@localhost:5432/dentaleus?schema=public"

# Authentication secret. Generate a long random value for each environment.
# AUTH_SECRET="replace-with-a-long-random-secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this through the deployment environment/secrets manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin for this deployment (used for absolute links and auth callbacks).
APP_URL="https://dentaleus.com" # Use http://localhost:4000 for local development
