{
  "name": "@dentaleus/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
